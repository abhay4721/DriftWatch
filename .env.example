# Local development values only. Replace these before any shared deployment.
POSTGRES_DB=driftwatch
POSTGRES_USER=driftwatch
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql+psycopg://driftwatch:change-this-local-password@postgres:5432/driftwatch
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-local-password
DRIFTWATCH_GITHUB_REPOSITORY=owner/repository
# Fine-grained token with Issues: write access to the configured repository.
DRIFTWATCH_GITHUB_TOKEN=
KUBECTL_VERSION=v1.37.1
